# karum-server environment variables.
#
# Every variable the gateway reads, with its default. The authoritative
# cross-repo list lives in karum-infra/.env.example; this file mirrors the
# variables that affect THIS process only.
#
# Copy and fill in the required values:
#
#   cp .env.example .env
#
# NEVER commit a filled-in .env. It is gitignored.

# --- Required --------------------------------------------------------------
# Database URI. The gateway uses it for campaigns, runs, evidence, and the
# judge account. There is no database container in Compose; this is always
# an external Postgres URI (local or hosted).
POSTGRES_DSN=

# Google Places API key. The gateway uses it for address, hours, website, and
# open status.
GOOGLE_PLACES_API_KEY=

# Google Routes API key. The gateway uses it to order the field-sales stops.
GOOGLE_ROUTES_API_KEY=

# --- Optional --------------------------------------------------------------
# Port the gateway listens on inside the container. Compose pins it to 8080
# and Caddy publishes the public origin; on the laptop `make local` starts the
# gateway on this port directly.
GATEWAY_PORT=8080

# HTTP server timeouts, as Go durations.
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=0s
GATEWAY_SHUTDOWN_TIMEOUT=10s

# Per-dependency deadlines for one outbound RPC.
GATEWAY_TASTE_TIMEOUT=8s
GATEWAY_AI_TIMEOUT=30s
GATEWAY_PLACES_TIMEOUT=5s
GATEWAY_ROUTES_TIMEOUT=15s

# Build version stamped into /health and log lines.
GATEWAY_VERSION=local

# Operational mode: live, fixture, or degraded.
GATEWAY_MODE=fixture

# gRPC dial targets. TASTE_ADDR and AI_ADDR stay the HTTP health addresses.
TASTE_GRPC_ADDR=localhost:9091
AI_GRPC_ADDR=localhost:9092

# Browser CORS allow-list, comma-separated. When empty, the gateway accepts
# loopback origins (localhost and 127.0.0.1 on any port) for `make local`.
CLIENT_ORIGIN=

# Geocoding API key. When empty, the gateway uses GOOGLE_PLACES_API_KEY.
GOOGLE_GEOCODING_API_KEY=

# Hackathon judge login. true enables POST /api/v1/auth/judge and reports
# hackathon_mode on GET /health.
HACKATHON_MODE=false

# Preseeded judge account. Set all three together. The gateway bcrypt-hashes the
# password before writing it to Postgres; the plaintext stays in .env locally
# and in Secret Manager in production. Never commit a real value.
JUDGE_EMAIL=
JUDGE_PASSWORD=
JUDGE_DISPLAY_NAME=Karum Judge

# Browser key for the Maps JavaScript API. `make local` and `make demo-refresh`
# pass it to Flutter as --dart-define=GOOGLE_MAPS_WEB_KEY. Restrict the key to
# maps-backend.googleapis.com and to the site origins. Empty falls back to
# CARTO tiles of OpenStreetMap data.
GOOGLE_MAPS_WEB_KEY=

# Opaque session lifetime, as a Go duration. Defaults to seven days.
SESSION_TTL=168h
